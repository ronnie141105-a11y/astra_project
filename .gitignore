# ---------------------------------------------------------------------------
# ASTRA .gitignore
# ---------------------------------------------------------------------------

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Environment / secrets
.env
.env.*
!.env.example

# Test / coverage / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Editors / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs / local scratch output
*.log
.ipynb_checkpoints/

